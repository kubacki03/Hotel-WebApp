@page
@model LoginModel

<div class="h-screen flex justify-center items-center bg-cover bg-center"
     style="background-image: url('https://manager.lbooking.online/CmsImages/hotel_warszawa_spa_(16).jpg');">

    <form asp-controller="Payout" asp-action="CreatePayout" method="post"
          class="bg-white/80 p-8 rounded-lg shadow-xl backdrop-blur-md w-full max-w-lg mx-4 sm:max-w-xl md:max-w-2xl">

        <h2 class="text-3xl font-semibold text-gray-800 text-center mb-6">Wyszukaj Rezerwację</h2>

        <div class="flex flex-wrap space-y-4 sm:space-y-0 sm:flex-row sm:space-x-4 mb-6">
            <div class="flex-1">
                <label for="date-start" class="block text-gray-700 font-semibold mb-2">Przyjazd</label>
                <input type="date" name="dateStart" id="date-start" required
                       class="bg-transparent border-2 border-gray-300 text-gray-700 outline-none px-4 py-2 rounded-md w-full focus:ring-2 focus:ring-amber-600 transition">
            </div>

            <div class="flex-1">
                <label for="date-end" class="block text-gray-700 font-semibold mb-2">Wyjazd</label>
                <input type="date" name="dateEnd" id="date-end" required
                       class="bg-transparent border-2 border-gray-300 text-gray-700 outline-none px-4 py-2 rounded-md w-full focus:ring-2 focus:ring-amber-600 transition">
            </div>

            <div class="flex-1">
                <label for="persons" class="block text-gray-700 font-semibold mb-2">Osoby</label>
                <input type="number" name="persons" id="persons" required min="1" max="10"
                       class="bg-transparent border-2 border-gray-300 text-gray-700 outline-none px-4 py-2 rounded-md w-full focus:ring-2 focus:ring-amber-600 transition">
            </div>
        </div>

        <button type="submit" class="w-full py-3 text-white bg-amber-700 hover:bg-amber-800 rounded-lg shadow-md font-semibold transition-all duration-300 disabled:opacity-50"
                id="submitButton" disabled>
            Szukaj
        </button>
    </form>
</div>

<br />

<h1 class="text-3xl font-bold text-center text-gray-900 mb-4 px-6 md:px-12">Program Partnerski LLC</h1>
<hr class="border-gray-300 mb-6" />

<p class="text-lg text-gray-700 leading-relaxed mb-8 px-6 md:px-12">
    Załóż konto, dołącz do programu LLC i korzystaj z dodatkowych przywilejów. Zarejestrowane konto to m.in. możliwość anulowania rezerwacji lub przeglądanie historii rezerwacji. Dodatkowo osoby, które przystąpią do programu partnerskiego LLC, za każdą rezerwację otrzymają punkty, którymi można opłacić kolejne pobyty.
</p>

<div id="login-section" class="flex justify-center items-center">
    <div class="bg-white p-8 rounded-lg shadow-xl w-full max-w-md">
        <form id="account" method="post">
            <h2 class="text-2xl font-semibold text-gray-800 mb-6">Zaloguj się</h2>

            <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

            <div class="form-floating mb-4">
                <input asp-for="Input.Email" class="form-control border-2 border-gray-300 p-3 rounded-md w-full text-gray-700 focus:ring-2 focus:ring-amber-600" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label text-gray-700">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.Password" class="form-control border-2 border-gray-300 p-3 rounded-md w-full text-gray-700 focus:ring-2 focus:ring-amber-600" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password" class="form-label text-gray-700">Hasło</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="checkbox mb-4">
                <label asp-for="Input.RememberMe" class="flex items-center text-gray-700">
                    <input class="form-check-input mr-2" asp-for="Input.RememberMe" />
                    <span class="text-sm">Zapamiętaj mnie</span>
                </label>
            </div>

            <div class="flex justify-center">
                <button id="login-submit" type="submit" class="w-full py-3 text-white bg-amber-700 hover:bg-amber-800 rounded-lg shadow-md font-semibold transition-all duration-300">
                    Zaloguj się
                </button>
            </div>

            <div class="text-center mt-4">
                <p class="text-sm">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-amber-700 hover:text-amber-900">Zapomniałeś hasła?</a>
                </p>
                <p class="text-sm">
                    <a href="/Identity/Account/Register#register-form" class="text-amber-700 hover:text-amber-900">Załóż konto</a>
                </p>
                <p class="text-sm">
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-amber-700 hover:text-amber-900">Wyślij ponownie e-mail z potwierdzeniem</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
