<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication11</title>
    <script type="importmap"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication11.styles.css" asp-append-version="true" />
</head>
<body class="relative">
    <header id="navbar" class="fixed top-0 left-0 w-full transition-all duration-300 ease-in-out z-50 bg-transparent">
        <nav class="mx-auto flex justify-between items-center p-4">
            <h1 class="text-white text-2xl font-bold">Quatro</h1>
            <ul class="flex space-x-6">
                <li><a href="/" class="text-white">Home</a></li>
                <li><a asp-controller="Cart" asp-action="ShowCart" class="text-white">Koszyk</a></li>

                @if (User.Identity.IsAuthenticated)
                {
                 

                    <li><a asp-controller="Reservation" asp-action="GetUserReservation" class="text-white">Witaj, <span class="text-white" id="user-name">...</span> </a></li>

                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="nav-link btn btn-link text-white">Wyloguj</button>
                    </form>
                }
                else
                {
                    <li><a href="/Identity/Account/Login#login-section" class="text-white">Zaloguj się</a></li>
                }
            </ul>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script>
        // Funkcja pobierająca imię użytkownika z API
        async function getUserName() {
            try {
                const response = await fetch('/getName');
                if (response.ok) {
                    const userName = await response.text();
                    // Ustawienie imienia użytkownika w HTML
                    document.getElementById("user-name").textContent = userName;
                } else {
                    console.error('Nie udało się pobrać imienia użytkownika');
                }
            } catch (error) {
                console.error('Błąd podczas pobierania imienia użytkownika:', error);
            }
        }

        // Wywołanie funkcji po załadowaniu strony
        window.addEventListener("DOMContentLoaded", getUserName);

        // Zmiana klasy na navbar podczas scrollowania
        window.addEventListener("scroll", function() {
            const navbar = document.getElementById("navbar");
            if (window.scrollY > 50) {
                navbar.classList.add("bg-zinc-900", "shadow-md");
                navbar.classList.remove("bg-transparent");
            } else {
                navbar.classList.add("bg-transparent");
                navbar.classList.remove("bg-zinc-900", "shadow-md");
            }
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
