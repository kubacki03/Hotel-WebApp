@model Dictionary<WebApplication11.Models.Room, int>

<div class="h-screen flex justify-center items-center bg-cover bg-center"
     style="background-image: url('https://manager.lbooking.online/CmsImages/hotel_warszawa_spa_(16).jpg');">

    <form asp-controller="Room" asp-action="getAvailableRooms" method="post"
          class="bg-white/80 p-8 rounded-lg shadow-xl backdrop-blur-md w-full max-w-lg mx-4 sm:max-w-xl md:max-w-2xl">

        <h2 class="text-3xl font-semibold text-gray-800 text-center mb-6">Mój koszyk</h2>

        <div class="flex flex-wrap space-y-4 sm:space-y-0 sm:flex-row sm:space-x-4 mb-6">
            @if (Model.Any())
            {
                <table class="table">
                    <thead>
                        <tr>

                            <th>Pokój</th>
                            <th>Ilość w koszyku</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Key.Type</td>


                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <button asp-controller="Payment" asp-action="CreateCheckoutSession" type="submit" class="w-full py-3 text-white bg-amber-700 hover:bg-amber-800 rounded-lg shadow-md font-semibold transition-all duration-300 disabled:opacity-50"
                id="submitButton" >
            Przejdź dalej
        </button>
    </form>
</div>

