<style>
    .przycisk {
        position: relative;
        z-index: 1;
    }

        .przycisk::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: tomato;
            z-index: -1;
            transition: transform 300ms ease-in-out;
            transform: scaleX(0);
            transform-origin: right;
        }

        .przycisk:hover::before,
        .przycisk:focus::before {
            transform: scaleX(1);
            transform-origin: left;
        }

    .slider {
        position: relative;
        overflow: hidden;
        width: 100%;
    }

    .slides {
        display: flex;
        transition: transform 1s ease;
    }

    .slide {
        min-width: 100%;
        height: 100vh; /* Wysokość slidera na 100% wysokości okna */
        object-fit: cover; /* Umożliwia przycięcie zdjęć, aby pasowały do rozmiaru */
    }

    .dots-container {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
    }

    .dot {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.7);
        transition: background-color 0.3s;
    }

        .dot.active {
            background-color: #fff;
        }
</style>

