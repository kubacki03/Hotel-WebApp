<script>
     document.addEventListener("DOMContentLoaded", function () {
        let today = new Date().toISOString().split("T")[0];

        let dateStart = document.getElementById("date-start");
        let dateEnd = document.getElementById("date-end");
        let submitButton = document.getElementById("submitButton");
        let errorMessage = document.createElement("p");

        // Ustawienie minimalnej daty na dzisiejszy dzień
        dateStart.setAttribute("min", today);
        dateEnd.setAttribute("min", today);

        // Tworzenie elementu błędu
        errorMessage.textContent = "Data przyjazdu nie może być późniejsza niż data wyjazdu!";
        errorMessage.classList.add("text-red-600", "mt-2", "hidden"); // Ukrywamy na start
        dateEnd.parentNode.appendChild(errorMessage);

        function validateDates() {
            let startDate = new Date(dateStart.value);
            let endDate = new Date(dateEnd.value);

            if (startDate > endDate || dateStart.value === dateEnd.value) {
                errorMessage.classList.remove("hidden");
                submitButton.disabled = true;
            } else {
                errorMessage.classList.add("hidden");
                submitButton.disabled = false;
            }
        }

        dateStart.addEventListener("change", validateDates);
        dateEnd.addEventListener("change", validateDates);
    });

     let currentIndex = 0;
    const slides = document.querySelector('.slides');
    const dots = document.querySelectorAll('.dot');

    function changeSlide(index) {
        // Aktualizujemy pozycję slides, aby wyświetlić odpowiedni obraz
        slides.style.transform = `translateX(-${index * 100}%)`;

        // Aktualizujemy aktywne kropki
        dots.forEach((dot, i) => {
            dot.classList.remove('active');
            if (i === index) {
                dot.classList.add('active');
            }
        });
    }

    // Funkcja zmieniająca slajdy automatycznie co 5 sekund
    setInterval(() => {
        currentIndex = (currentIndex + 1) % dots.length;
        changeSlide(currentIndex);
    }, 5000);

    // Obsługa kliknięcia w kropki
    dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
            currentIndex = index;
            changeSlide(currentIndex);
        });
    });
</script>
